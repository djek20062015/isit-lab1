@startuml
skinparam componentStyle uml2
 
actor "Пользователь / Организатор" as User
actor "Администратор" as Admin
 
package "Клиентская часть (Frontend)" {
  [Web Application (React / Vue)] as WebApp
}
 
package "Серверная часть (Backend API)" {
  [API Gateway / Router] as Gateway
  [Модуль Аутентификации (Auth Service)] as AuthService
  [Сервис Мероприятий (Event Service)] as EventService
  [Сервис Бронирования (Booking Service)] as BookingService
  [Сервис Уведомлений (Notification Service)] as NotifyService
}
 
database "База данных (PostgreSQL)" as DB
component "SMTP-сервер (Email)" as EmailServer
 
User --> WebApp : HTTPS
Admin --> WebApp : HTTPS
 
WebApp --> Gateway : REST API / JSON
 
Gateway --> AuthService
Gateway --> EventService
Gateway --> BookingService
 
AuthService --> DB : SQL
EventService --> DB : SQL
BookingService --> DB : SQL
 
BookingService ..> NotifyService : Событие (Регистрация)
NotifyService --> EmailServer : SMTP
@enduml
